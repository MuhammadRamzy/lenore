  "narrative": {
    "northStar": "Architectural luxury, working precision",
    "overview": "Buyer surfaces pair warm limestone, charcoal planes and restrained bronze with strong photography. Marcellus gives display headings an architectural cadence; Manrope keeps product information and actions precise. Square edges, fine rules and generous spacing let materials and merchandise lead.\n\nStaff surfaces use a separate industrial system: dark slate navigation, cool white working regions, compact Manrope hierarchy and ruled records. Customer quotations adapt the buyer identity to white paper and bilingual Noto typography. The supplied Lenore logo remains the binding identity asset across these surfaces.\n\nThis records the implemented direction selected by the user after rejecting the original interface, as captured in ADR 0003. That choice supersedes the old botanical ivory/Cormorant buyer treatment. Implementation is the visual source of truth; no approved comp or separate quality-bar board is claimed.",
    "keyCharacteristics": [
      "Warm stone, charcoal and bronze buyer materials.",
      "Photographic emphasis with explicit illustrative provenance.",
      "Architectural display type and precise working typography.",
      "Separate, dense staff records with clear operational states."
    ],
    "rules": [
      {
        "name": "The Surface Scope Rule",
        "body": "Keep buyer material tokens scoped to the public site and staff tokens scoped to the workspace and sign-in surfaces.",
        "section": "colors"
      },
      {
        "name": "The Working Type Rule",
        "body": "Reserve Marcellus for buyer display hierarchy; keep staff tasks, controls and product facts in Manrope.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** preserve the supplied Lenore mark and the separate buyer/staff palettes.",
      "**Do** use architectural display typography with precise Manrope product facts.",
      "**Do** keep required illustrative disclosures readable and separate from action icons.",
      "**Do** show the whole product or poster in detail views.",
      "**Do** qualify suggested MRP, unknown prices and stock honestly across web and PDF.",
      "**Do** keep keyboard focus, reduced motion and explicit error/empty states usable."
    ],
    "donts": [
      "**Don't** restore the rejected Cormorant/botanical public identity.",
      "**Don't** treat generated samples or inspiration scenes as real merchandise or approved product photography.",
      "**Don't** let public palette or display type spread into staff working records.",
      "**Don't** infer quality claims, contact details or connected stock from illustrative content.",
      "**Don't** use card shadows or rounded chrome to replace the established tonal planes and fine rules."
    ]
  }
