      "html": "<article class=\"ds-product\"><button class=\"ds-product-media\">Product photography pending <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path d=\"M7 17 17 7M7 7h10v10\"/></svg></button><div class=\"ds-product-meta\"><span>DEMO-BM01 · Basin mixers</span><span>Illustrative record</span></div><h3>Illustrative basin mixer</h3><div class=\"ds-product-bottom\"><div><small>Suggested MRP</small><strong>To be confirmed</strong></div><button aria-label=\"Add illustrative basin mixer\">+</button></div></article>",
