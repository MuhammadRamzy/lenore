      "css": ".ds-category{--paper:#f7f5f0;--white:#fffefa;--ink:#282620;--muted:#6a655c;--line:#dcd6cb;--accent:#785b3b;--sage:#ece7dd;--olive:#39382f;font-family:Manrope,sans-serif;display:flex;gap:3px;flex-wrap:wrap;}.ds-category button{font-family:Manrope,sans-serif;padding:12px 14px;min-height:42px;border:1px solid transparent;border-radius:0;background:transparent;color:var(--muted);font-size:12px;cursor:pointer;}.ds-category button[aria-pressed=true]{background:#e9e2d6;border-color:#ded3c1;color:var(--ink);font-weight:600;}.ds-category button:hover{color:var(--ink);}.ds-category button:focus-visible{outline:2px solid var(--accent);outline-offset:4px;}"
